# App
NODE_ENV=development
APP_VERSION=0.1.0
PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000

# Postgres (document metadata + chunk text)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag
POSTGRES_POOL_MAX=10

# Redis (BullMQ job queue)
REDIS_URL=redis://localhost:6379/0

# HuggingFace (https://huggingface.co/settings/tokens → token with "Inference Providers" permission)
HF_TOKEN=
# Multilingual model with Bangla support; EMBEDDING_DIM must match it (bge-m3 = 1024)
HF_EMBEDDING_MODEL=BAAI/bge-m3
# hf-inference = served by HuggingFace itself; "auto" = first available provider
HF_PROVIDER=hf-inference
EMBEDDING_DIM=1024

# Pinecone (https://app.pinecone.io → API Keys)
PINECONE_API_KEY=
PINECONE_INDEX=bd-circulars
PINECONE_NAMESPACE=circulars
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Groq (https://console.groq.com → API Keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Storage for downloaded raw documents
DATA_DIR=./data