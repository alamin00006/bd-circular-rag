{
  "name": "bd-circular-rag",
  "version": "0.1.0",
  "description": "Bangla-first RAG over Bangladesh Bank circulars and NBR notifications",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node init && tsx watch src/server.ts",
    "worker": "tsx watch src/worker.ts",
    "migrate": "tsx src/db/migrate.ts",
    "setup": "tsx src/scripts/setup.ts",
    "build": "node init && tsc -p tsconfig.build.json",
    "start": "node init && node dist/server.js",
    "start:worker": "node init && node dist/worker.js",
    "migrate:prod": "node dist/db/migrate.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@huggingface/inference": "^4.13.32",
    "@langchain/core": "^1.3.5",
    "@langchain/groq": "^1.3.1",
    "@langchain/pinecone": "^1.0.3",
    "@langchain/textsplitters": "^1.0.2",
    "@pinecone-database/pinecone": "^5.1.2",
    "bullmq": "^6.7.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "ioredis": "^6.0.0",
    "node-fetch": "^3.3.2",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
